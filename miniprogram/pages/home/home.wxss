.page {
  min-height: 100vh;
  background: #f2f3f5;
  transition: background 0.25s ease;
}

/* —— 沉浸导航 —— */
.nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 100;
  background: rgba(242, 243, 245, 0.86);
  backdrop-filter: blur(20px);
  transition: background 0.25s ease;
}

.nav-inner {
  display: flex;
  align-items: center;
  padding-left: 40rpx;
  padding-right: 220rpx;
  box-sizing: border-box;
}

.nav-logo {
  font-size: 34rpx;
  font-weight: 600;
  color: #111827;
  letter-spacing: 1rpx;
  transition: color 0.25s ease;
  flex: 1;
  min-width: 0;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.mode-btn {
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.06);
  color: #4b5563;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.mode-btn.is-box {
  background: #111827;
  color: #ffffff;
}

.mode-btn-hover {
  opacity: 0.88;
}

/* —— 主题开关（Bouncy Toggle 近似） —— */
.theme-toggle {
  width: 92rpx;
  height: 52rpx;
  padding: 4rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
  box-sizing: border-box;
  position: relative;
  flex-shrink: 0;
  transition: background 0.25s ease;
}

.theme-toggle-hover {
  opacity: 0.92;
}

.theme-toggle.is-dark {
  background: #374151;
}

.theme-knob {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(17, 24, 39, 0.16);
  transform: translateX(0) scale(1);
  transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.25s ease;
}

.theme-toggle.is-dark .theme-knob {
  background: #111827;
  transform: translateX(40rpx) scale(1);
}

/* 切到浅色：从右弹回左 */
.theme-toggle.is-bounce .theme-knob {
  animation: theme-knob-to-light 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 切到深色：从左弹到右 */
.theme-toggle.is-dark.is-bounce .theme-knob {
  animation-name: theme-knob-to-dark;
}

@keyframes theme-knob-to-dark {
  0% { transform: translateX(0) scale(1); }
  55% { transform: translateX(40rpx) scale(1.12); }
  100% { transform: translateX(40rpx) scale(1); }
}

@keyframes theme-knob-to-light {
  0% { transform: translateX(40rpx) scale(1); }
  55% { transform: translateX(0) scale(1.12); }
  100% { transform: translateX(0) scale(1); }
}

.theme-icon {
  font-size: 24rpx;
  line-height: 1;
  color: #f59e0b;
}

.theme-toggle.is-dark .theme-icon {
  color: #93c5fd;
}

/* —— 内容 —— */
.body {
  padding: 24rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.footer-slogan {
  margin-top: 48rpx;
  margin-bottom: 8rpx;
  text-align: center;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: #9ca3af;
  font-weight: 500;
}

.hero-row {
  position: relative;
  width: 100%;
  /* 与背景图 1024×271 同比例，完整显示 */
  aspect-ratio: 1024 / 271;
  height: auto;
  margin: 16rpx 0 24rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  overflow: hidden;
  background: #f7f7f7;
}

.hero-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

/* —— 语录区 —— */
.quote {
  position: relative;
  width: 100%;
  margin: 0 0 32rpx;
  padding: 36rpx 28rpx 28rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
}

.quote-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 20rpx;
  color: #9ca3af;
  letter-spacing: 2rpx;
  font-weight: 500;
}

.quote-main {
  position: relative;
  padding: 8rpx 0 36rpx;
}

.quote-mark {
  position: absolute;
  left: 0;
  top: 0;
  font-size: 44rpx;
  line-height: 1;
  color: rgba(156, 163, 175, 0.55);
  font-weight: 700;
  z-index: 1;
}

.quote-text {
  display: block;
  position: relative;
  z-index: 1;
  padding: 8rpx 8rpx 0 12rpx;
  font-size: 26rpx;
  color: #1f2937;
  line-height: 1.6;
  font-weight: 500;
}

.quote-tip {
  position: absolute;
  left: 12rpx;
  bottom: 0;
  z-index: 1;
  font-size: 18rpx;
  color: #9ca3af;
}

.quote-share {
  position: absolute;
  right: 24rpx;
  bottom: 22rpx;
  z-index: 2;
  height: 48rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.06);
  color: #374151;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 48rpx;
  text-align: center;
}

.quote-share-hover {
  background: rgba(17, 24, 39, 0.12);
}

.quote-share.is-busy {
  opacity: 0.55;
}

.quote-share-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 1000px;
  pointer-events: none;
}

/* —— 工具面板 —— */
.panel {
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 1rpx 0 rgba(17, 24, 39, 0.04);
}

.panel-sorting {
  box-shadow: 0 8rpx 28rpx rgba(17, 24, 39, 0.08);
}

.row {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #f0f1f3;
  background: #ffffff;
  transition: background 0.15s ease, transform 0.15s ease;
}

.row-last {
  border-bottom: none;
}

.row-hover {
  background: #f7f8fa;
}

.row-dragging {
  background: #f7f8fa;
  transform: scale(1.02);
  box-shadow: 0 10rpx 28rpx rgba(17, 24, 39, 0.12);
  z-index: 2;
  position: relative;
}

.row-icon {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  background: transparent;
}

.row-icon-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: transparent;
  color: #9ca3af;
  font-size: 30rpx;
  font-weight: 700;
}

.row-text {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  margin-right: 16rpx;
}

.row-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.3;
}

.row-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-trail {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.row-handle {
  font-size: 28rpx;
  color: #d1d5db;
  line-height: 1;
  letter-spacing: -2rpx;
  padding: 8rpx 4rpx;
}

/* —— 深色主题（仅首页） —— */
.theme-dark {
  background: #0f1115;
}

.theme-dark .nav {
  background: rgba(15, 17, 21, 0.88);
}

.theme-dark .nav-logo {
  color: #f3f4f6;
}

.theme-dark .footer-slogan {
  color: #6b7280;
}

.theme-dark .hero-row {
  background: #1a1d24;
}

.theme-dark .quote {
  background: #1c212b;
}

.theme-dark .quote-label {
  color: #6b7280;
}

.theme-dark .quote-mark {
  color: rgba(156, 163, 175, 0.35);
}

.theme-dark .quote-text {
  color: #e5e7eb;
}

.theme-dark .quote-tip {
  color: #6b7280;
}

.theme-dark .quote-share {
  background: rgba(255, 255, 255, 0.08);
  color: #e5e7eb;
}

.theme-dark .quote-share-hover {
  background: rgba(255, 255, 255, 0.14);
}

.theme-dark .panel {
  background: #1c212b;
  box-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.04);
}

.theme-dark .panel-sorting {
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.35);
}

.theme-dark .row {
  background: #1c212b;
  border-bottom-color: #2a3140;
}

.theme-dark .row-hover {
  background: #252b38;
}

.theme-dark .row-dragging {
  background: #252b38;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.4);
}

.theme-dark .row-name {
  color: #f3f4f6;
}

.theme-dark .row-desc {
  color: #9ca3af;
}

.theme-dark .row-handle {
  color: #4b5563;
}

.theme-dark .row-icon-fallback {
  color: #6b7280;
}

.theme-dark .mode-btn {
  background: rgba(255, 255, 255, 0.08);
  color: #d1d5db;
}

.theme-dark .mode-btn.is-box {
  background: #f3f4f6;
  color: #111827;
}

.theme-dark .toy-box {
  background: #1c212b;
  box-shadow:
    0 1rpx 0 rgba(255, 255, 255, 0.04),
    0 10rpx 28rpx rgba(0, 0, 0, 0.28);
}

.theme-dark .toy-stage {
  background: #161a22;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.04),
    inset 0 14rpx 28rpx rgba(0, 0, 0, 0.28);
}

.theme-dark .box-tip {
  background: rgba(0, 0, 0, 0.62);
  color: #e5e7eb;
}

.theme-dark .toy-floor {
  background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.28));
}

.theme-dark .toy-tile {
  background: #252b38;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.35);
  border-color: rgba(255, 255, 255, 0.04);
}

.theme-dark .preview-card {
  background: #1c212b;
}

.theme-dark .preview-name {
  color: #f3f4f6;
}

.theme-dark .preview-desc {
  color: #9ca3af;
}

.theme-dark .preview-btn.ghost {
  background: #252b38;
  color: #d1d5db;
}

/* —— 箱子模式（玩具抽屉） —— */
.toy-box {
  position: relative;
  border-radius: 28rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow:
    0 1rpx 0 rgba(17, 24, 39, 0.04),
    0 10rpx 28rpx rgba(17, 24, 39, 0.05);
}

.toy-stage {
  position: relative;
  width: 100%;
  height: 520rpx;
  border-radius: 22rpx;
  overflow: hidden;
  box-sizing: border-box;
  background: #f3f1ec;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9),
    inset 0 14rpx 28rpx rgba(17, 24, 39, 0.05),
    inset 0 -1rpx 0 rgba(17, 24, 39, 0.04);
}

.box-tip {
  position: absolute;
  left: 50%;
  top: 28rpx;
  z-index: 30;
  transform: translateX(-50%);
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.72);
  color: #f9fafb;
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  line-height: 1.4;
  white-space: nowrap;
  pointer-events: auto;
  animation: box-tip-in 0.35s ease;
}

@keyframes box-tip-in {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(-8rpx);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
}

.toy-floor {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 18rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, transparent, rgba(17, 24, 39, 0.05));
  pointer-events: none;
  z-index: 0;
}

.boom-flash {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 5;
  pointer-events: none;
  background: radial-gradient(circle at center, rgba(255, 220, 120, 0.55), rgba(255, 80, 40, 0.2) 42%, transparent 70%);
  animation: boom-flash-fade 0.28s ease-out forwards;
}

@keyframes boom-flash-fade {
  0% { opacity: 1; }
  100% { opacity: 0; }
}

.toy-tile {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 1;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(17, 24, 39, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid rgba(17, 24, 39, 0.03);
  transform-origin: center center;
  will-change: transform;
  backface-visibility: hidden;
}

.toy-icon {
  width: 72%;
  height: 72%;
}

.toy-egg {
  border-radius: 50% !important;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.78);
  border: none;
  box-shadow: 0 8rpx 16rpx rgba(17, 24, 39, 0.1);
  z-index: 0;
}

.toy-icon-egg {
  width: 78%;
  height: 78%;
  opacity: 1;
}

.theme-dark .toy-egg {
  background: rgba(37, 43, 56, 0.92);
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.35);
  border: none;
}

.toy-mark {
  font-size: 28rpx;
  font-weight: 700;
  color: #6b7280;
}

/* —— 彩蛋表情包 —— */
.meme-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 220;
  background: rgba(17, 24, 39, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
}

.meme-card {
  width: 100%;
  max-width: 560rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 48rpx rgba(17, 24, 39, 0.22);
}

.meme-img {
  width: 100%;
  display: block;
  border-radius: 16rpx;
}

.meme-close {
  margin-top: 24rpx;
  height: 80rpx;
  border-radius: 18rpx;
  background: #111827;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.theme-dark .meme-card {
  background: #1c212b;
}

.theme-dark .meme-close {
  background: #f3f4f6;
  color: #111827;
}

/* —— 简介卡 —— */
.preview-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(17, 24, 39, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.preview-card {
  width: 100%;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 48rpx rgba(17, 24, 39, 0.18);
}

.preview-icon {
  width: 120rpx;
  height: 120rpx;
}

.preview-icon-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #f3f4f6;
  color: #6b7280;
  font-size: 40rpx;
  font-weight: 700;
}

.preview-name {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
  text-align: center;
}

.preview-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6b7280;
  text-align: center;
  line-height: 1.5;
}

.preview-actions {
  margin-top: 32rpx;
  width: 100%;
  display: flex;
  gap: 16rpx;
}

.preview-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.preview-btn.ghost {
  background: #f3f4f6;
  color: #4b5563;
}

.preview-btn.primary {
  background: #111827;
  color: #ffffff;
}
