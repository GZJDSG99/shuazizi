.page {
  min-height: 100vh;
  background: #f2f3f5;
}

.nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 100;
  background: rgba(242, 243, 245, 0.88);
  backdrop-filter: blur(20px);
}

.nav-inner {
  display: flex;
  align-items: center;
  padding-left: 8rpx;
  padding-right: 200rpx;
  box-sizing: border-box;
}

.nav-back {
  width: 72rpx;
  height: 64rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 48rpx;
  color: #111827;
  font-weight: 300;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.body {
  padding: 16rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 1rpx 0 rgba(17, 24, 39, 0.04);
}

.hero {
  text-align: center;
  padding: 48rpx 28rpx 40rpx;
}

.hero-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.hero-label {
  display: block;
  font-size: 26rpx;
  color: #9ca3af;
}

.hero-days {
  display: block;
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 800;
  color: #111827;
  line-height: 1.3;
}

.hero-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.share-btn {
  display: inline-block;
  margin-top: 28rpx;
  height: 64rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  background: #111827;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 64rpx;
}

.share-btn-hover {
  opacity: 0.88;
}

.share-btn.is-busy,
.share-btn.is-disabled {
  opacity: 0.45;
}

.share-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 1000px;
  pointer-events: none;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 8rpx 0;
  min-height: 72rpx;
}

.field-block {
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}

.field-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-label {
  font-size: 28rpx;
  color: #6b7280;
  flex-shrink: 0;
}

.field-edit {
  font-size: 24rpx;
  color: #111827;
  padding: 6rpx 16rpx;
  background: #f2f3f5;
  border-radius: 999rpx;
  font-weight: 600;
}

.field-template {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.4;
}

.field-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  text-align: right;
}

.divider {
  height: 1rpx;
  background: #f0f1f3;
  margin: 12rpx 0;
}

.hint {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #c0c4cc;
  line-height: 1.5;
}

.actions {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.btn-main,
.btn-sub {
  flex: 1;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 20rpx !important;
  font-size: 28rpx !important;
  line-height: 2.5 !important;
}

.btn-main {
  background: #111827 !important;
  color: #fff !important;
  font-weight: 700 !important;
}

.btn-main::after,
.btn-sub::after {
  border: none;
}

.btn-sub {
  background: #fff !important;
  color: #6b7280 !important;
  border: 1rpx solid #e5e7eb !important;
}
