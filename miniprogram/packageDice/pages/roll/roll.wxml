<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-inner" style="height: {{navBarHeight}}px;">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title">掷骰子</text>
    </view>
  </view>

  <view class="sheet" style="padding-top: {{navTotalHeight}}px;">
    <view class="sheet-inner">
      <view class="hero">
        <text class="hero-title">掷骰子</text>
        <text class="hero-sub">{{rolling ? '骰子滚动中…' : '点击按钮开始掷骰子'}}</text>
      </view>

      <view class="stage">
        <view wx:if="{{rolling}}" class="cup-wrap {{shake ? 'is-shake' : ''}}">
          <image class="cup" src="/images/dice/cup.png" mode="aspectFit" />
        </view>
        <view wx:else class="dice-board count-{{diceCount}}">
          <image
            wx:for="{{faces}}"
            wx:key="index"
            class="die die-{{index}}"
            src="/images/dice/dice-{{item}}.png"
            mode="aspectFit"
          />
        </view>
      </view>

      <view class="footer">
        <button
          class="btn-roll {{rolling ? 'is-disabled' : ''}}"
          disabled="{{rolling}}"
          bindtap="onRoll"
        >掷骰子</button>

        <view class="count-row">
          <view
            wx:for="{{countOptions}}"
            wx:key="*this"
            class="count-btn {{diceCount === item ? 'count-on' : ''}} {{rolling ? 'is-disabled' : ''}}"
            data-count="{{item}}"
            bindtap="onPickCount"
          >{{item}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
