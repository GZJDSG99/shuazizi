.page {
  min-height: 100vh;
  background: #f2f3f5;
  box-sizing: border-box;
}

.nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 100;
  background: rgba(242, 243, 245, 0.92);
  backdrop-filter: blur(20px);
}

.nav-inner {
  display: flex;
  align-items: center;
  padding-left: 8rpx;
  padding-right: 220rpx;
  box-sizing: border-box;
}

.nav-back {
  width: 72rpx;
  height: 64rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 48rpx;
  color: #111827;
  font-weight: 300;
  flex-shrink: 0;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  flex: 1;
  min-width: 0;
}

.stage {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(220rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 1rpx 0 rgba(17, 24, 39, 0.04);
}

.canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.dock {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
  padding: 24rpx 24rpx 20rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(17, 24, 39, 0.06);
}

.row {
  display: flex;
  align-items: center;
}

.colors {
  gap: 16rpx;
  justify-content: space-between;
}

.swatch {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  box-sizing: border-box;
  border: 4rpx solid transparent;
  flex-shrink: 0;
}

.swatch-on {
  border-color: #111827;
  transform: scale(1.08);
}

.eraser {
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.eraser-mark {
  font-size: 22rpx;
  font-weight: 700;
  color: #6b7280;
}

.tools {
  margin-top: 24rpx;
  justify-content: space-between;
  gap: 16rpx;
}

.sizes {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.size-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.size-on {
  background: #111827;
}

.size-dot {
  border-radius: 50%;
  background: #6b7280;
}

.size-on .size-dot {
  background: #ffffff;
}

.actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.action-btn {
  padding: 14rpx 22rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #6b7280;
  background: #f3f4f6;
  border-radius: 16rpx;
}

.action-primary {
  color: #ffffff;
  background: #111827;
}
