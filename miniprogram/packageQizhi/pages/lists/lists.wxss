.page {
  min-height: 100vh;
  background: #f2f3f5;
}

.nav-shell {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 100;
  background: rgba(242, 243, 245, 0.88);
  backdrop-filter: blur(20px);
}

.nav-bar {
  display: flex;
  align-items: center;
  padding-left: 8rpx;
  padding-right: 220rpx;
  box-sizing: border-box;
}

.nav-back {
  width: 72rpx;
  height: 64rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 48rpx;
  color: #111827;
  font-weight: 300;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.main {
  padding: 16rpx 32rpx 220rpx;
  box-sizing: border-box;
}

.hero {
  margin-bottom: 28rpx;
  padding: 8rpx 8rpx 4rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #111827;
}

.hero-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #9ca3af;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  box-shadow: 0 1rpx 0 rgba(17, 24, 39, 0.04);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.card-name {
  font-size: 32rpx;
  font-weight: 600;
  flex: 1;
  color: #111827;
}

.card-meta {
  font-size: 22rpx;
  color: #9ca3af;
  flex-shrink: 0;
}

.card-money {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
}

.card-actions {
  display: flex;
  gap: 12rpx;
}

.mini {
  margin: 0 !important;
  background: #f2f3f5 !important;
  color: #374151 !important;
  border: none !important;
  font-size: 22rpx !important;
  line-height: 2 !important;
  padding: 0 18rpx !important;
  border-radius: 10rpx !important;
}

.mini::after {
  border: none;
}

.mini.danger {
  background: #fef2f2 !important;
  color: #dc2626 !important;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(242, 243, 245, 0.94);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
