<view class="page">
  <view class="nav-shell" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar" style="height: {{navBarHeight}}px;">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title">掐指一算</text>
    </view>
  </view>

  <view class="main" style="padding-top: {{navTotalHeight}}px;">
  <view class="hero">
    <view class="hero-title">我的清单</view>
    <view class="hero-desc">可建多份清单，各自备份、分享长图</view>
  </view>

  <view wx:if="{{!lists.length}}" class="empty">
    <view class="empty-title">还没有清单</view>
    <view class="empty-desc">例如：装修预算、旅行开销、婚礼清单</view>
    <button class="btn-primary" bindtap="onCreate">新建清单</button>
  </view>

  <view wx:else class="list">
    <view
      class="card"
      wx:for="{{lists}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpen"
    >
      <view class="card-top">
        <text class="card-name">{{item.name}}</text>
        <text class="card-meta">{{item.categoryCount}} 类 · {{item.itemCount}} 项</text>
      </view>
      <view class="card-money">
        <text class="money">估 ¥{{item.estimatedText}}</text>
        <text class="money">实 ¥{{item.actualText}}</text>
        <text class="money {{item.diffClass}}">{{item.diffText}}</text>
      </view>
      <view class="card-actions" catchtap="noop">
        <button class="mini" size="mini" data-id="{{item.id}}" data-name="{{item.name}}" catchtap="onRename">改名</button>
        <button class="mini danger" size="mini" data-id="{{item.id}}" data-name="{{item.name}}" catchtap="onDelete">删除</button>
      </view>
    </view>
  </view>

  <view wx:if="{{lists.length}}" class="footer">
    <button class="btn-primary" bindtap="onCreate">＋ 新建清单</button>
    <button class="btn-ghost" bindtap="onImportNew">从剪贴板导入为新清单</button>
  </view>
  </view>
</view>
