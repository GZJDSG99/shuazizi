.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
}

.card {
  background: #fff;
  border-radius: var(--radius);
  border: 1rpx solid var(--color-border);
  padding: 8rpx 24rpx 24rpx;
}

.field {
  margin-top: 20rpx;
}

.label {
  font-size: 24rpx;
  color: var(--color-muted);
  margin-bottom: 8rpx;
}

.input {
  background: #fff;
  border: 1rpx solid #d0d5dd;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  min-height: 80rpx;
}

.input.fill {
  background: var(--color-fill);
  border-color: var(--color-fill-border);
}

.input.picker {
  line-height: 44rpx;
}

.input.placeholder {
  color: #999;
}

.row-2 {
  display: flex;
  gap: 16rpx;
}

.half {
  flex: 1;
}

.diff-box {
  margin-top: 20rpx;
  background: var(--color-primary-soft);
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  background: #fff;
  border: 1rpx solid #d0d5dd;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}

.footer {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
