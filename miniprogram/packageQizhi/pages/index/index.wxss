.page {
  min-height: 100vh;
  padding: 16rpx 24rpx 160rpx;
}

.top-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.share-btn {
  margin: 0 !important;
  background: #fff !important;
  color: var(--color-primary) !important;
  border: 1rpx solid var(--color-primary) !important;
  font-size: 24rpx !important;
}

.share-btn::after {
  border: none;
}

.summary {
  display: flex;
  background: #fff;
  border-radius: var(--radius);
  border: 1rpx solid var(--color-border);
  padding: 24rpx 8rpx;
  margin-bottom: 20rpx;
}

.sum-item {
  flex: 1;
  text-align: center;
  padding: 0 8rpx;
}

.sum-label {
  font-size: 22rpx;
  color: var(--color-muted);
  margin-bottom: 8rpx;
}

.sum-value {
  font-size: 30rpx;
  font-weight: 700;
  word-break: break-all;
}

.tabs-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tabs {
  flex: 1;
  width: 0;
  height: 96rpx;
  white-space: nowrap;
}

.tabs-inner {
  display: inline-block;
  white-space: nowrap;
  height: 96rpx;
  padding-right: 8rpx;
}

.tab {
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  vertical-align: top;
  background: #fff;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  margin-right: 12rpx;
  min-width: 120rpx;
  height: 84rpx;
  box-sizing: border-box;
}

.tab.on {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
}

.tab-name {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.3;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab-sub {
  font-size: 20rpx;
  opacity: 0.85;
  margin-top: 2rpx;
}

.tab.manage {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  border: 1rpx solid transparent;
  border-radius: 999rpx;
  padding: 0 28rpx;
  height: 84rpx;
  font-weight: 600;
  font-size: 26rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item-card {
  background: #fff;
  border-radius: var(--radius);
  border: 1rpx solid var(--color-border);
  padding: 24rpx;
}

.item-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
}

.item-diff {
  font-size: 24rpx;
  flex-shrink: 0;
}

.item-money {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.amt {
  font-size: 24rpx;
  color: #555;
  background: #f3f4f6;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.amt.pending {
  background: var(--color-fill);
  border: 1rpx solid var(--color-fill-border);
  color: #8a6d1d;
}

.item-extra {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.empty.soft {
  background: #fff;
  border-radius: var(--radius);
  border: 1rpx dashed var(--color-border);
  margin-top: 8rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: 56rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(30, 74, 140, 0.35);
  z-index: 20;
}

.share-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 750px;
  height: 8000px;
}
