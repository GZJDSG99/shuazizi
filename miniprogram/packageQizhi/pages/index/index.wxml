<view class="page">
  <view class="top-actions">
    <button class="share-btn" size="mini" bindtap="onBackup">备份</button>
    <button class="share-btn" size="mini" bindtap="onShare" loading="{{sharing}}">分享长图</button>
  </view>

  <view class="summary">
    <view class="sum-item">
      <view class="sum-label">预估合计</view>
      <view class="sum-value money">¥{{totalEstimatedText}}</view>
    </view>
    <view class="sum-item">
      <view class="sum-label">实际合计</view>
      <view class="sum-value money">¥{{totalActualText}}</view>
    </view>
    <view class="sum-item">
      <view class="sum-label">差额</view>
      <view class="sum-value money {{totalDiffClass}}">{{totalDiffText}}</view>
    </view>
  </view>

  <view wx:if="{{!categories.length}}" class="empty">
    <view class="empty-title">先建一个分类</view>
    <view class="empty-desc">分类可自定义，例如材料、人工、其他</view>
    <button class="btn-primary" bindtap="goCategory">去管理分类</button>
  </view>

  <block wx:else>
    <view class="tabs-bar">
      <scroll-view
        class="tabs"
        scroll-x
        enhanced
        show-scrollbar="{{false}}"
        scroll-with-animation
        scroll-into-view="{{scrollIntoView}}"
      >
        <view class="tabs-inner">
          <view
            wx:for="{{categories}}"
            wx:key="id"
            id="tab-{{item.id}}"
            class="tab {{activeCategoryId === item.id ? 'on' : ''}}"
            data-id="{{item.id}}"
            bindtap="onTabTap"
          >
            <view class="tab-name">{{item.name}}</view>
            <view class="tab-sub money">¥{{item.subText}}</view>
          </view>
        </view>
      </scroll-view>
      <view class="tab manage" bindtap="goCategory">管理</view>
    </view>

    <view wx:if="{{!items.length}}" class="empty soft">
      <view class="empty-title">这个分类还没有项目</view>
      <view class="empty-desc">点下方加号，记一笔预估或实际花费</view>
    </view>

    <view wx:else class="list">
      <view
        class="item-card"
        wx:for="{{items}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onItemTap"
      >
        <view class="item-top">
          <text class="item-name">{{item.name}}</text>
          <text class="item-diff money {{item.diffClass}}">{{item.diffText}}</text>
        </view>
        <view class="item-money">
          <text class="amt {{item.estimatedEmpty ? 'pending' : ''}}">估 {{item.estimatedText}}</text>
          <text class="amt {{item.actualEmpty ? 'pending' : ''}}">实 {{item.actualText}}</text>
        </view>
        <view wx:if="{{item.brandSpec}}" class="item-extra">{{item.brandSpec}}</view>
      </view>
    </view>
  </block>

  <view wx:if="{{categories.length}}" class="fab" bindtap="onAdd">＋</view>

  <canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>
</view>
