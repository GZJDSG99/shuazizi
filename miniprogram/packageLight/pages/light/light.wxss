.page {
  min-height: 100vh;
  position: relative;
  box-sizing: border-box;
}

.nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 100;
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.nav.is-hidden {
  opacity: 0;
  pointer-events: none;
  transform: translateY(-8rpx);
}

.nav-inner {
  display: flex;
  align-items: center;
  padding-left: 8rpx;
  padding-right: 200rpx;
  box-sizing: border-box;
}

.nav-back {
  width: 72rpx;
  height: 64rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 48rpx;
  color: rgba(17, 24, 39, 0.72);
  font-weight: 300;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: rgba(17, 24, 39, 0.72);
}

.hint {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 22rpx;
  color: rgba(17, 24, 39, 0.28);
  pointer-events: none;
  z-index: 10;
}

.dock {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 20;
  padding: 28rpx 28rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(20px);
  box-shadow: 0 8rpx 32rpx rgba(17, 24, 39, 0.08);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.dock.is-hidden {
  opacity: 0;
  pointer-events: none;
  transform: translateY(16rpx);
}

.modes {
  display: flex;
  gap: 16rpx;
}

.mode {
  flex: 1;
  height: 88rpx;
  border-radius: 18rpx;
  border: 2rpx solid rgba(17, 24, 39, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.mode-on {
  border-color: #111827;
  box-shadow: inset 0 0 0 2rpx #111827;
}

.mode-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #111827;
}

.bright-row {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.bright-label {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #6b7280;
  width: 56rpx;
}

.bright-slider {
  flex: 1;
  margin: 0;
}

.bright-pct {
  flex-shrink: 0;
  width: 72rpx;
  text-align: right;
  font-size: 24rpx;
  color: #6b7280;
  font-variant-numeric: tabular-nums;
}
